          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Juan Sebastian\",\n  \"apellido\": \"Jimenez Satizabal\",\n  \"correo\": \"juan@correo.com\",\n  \"contrasena\": \"Clave12345\",\n  \"fecha_nacimiento\": \"2000-05-20\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/auth/registro",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "registro"
          ]
        },
        "description": "Espera 201"
      }
